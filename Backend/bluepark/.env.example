# Copy this file to .env and fill in real values.
# Not required for local dev — bluepark.settings.dev works with no .env at all.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Database (django-environ URL format)
# Postgres: postgres://USER:PASSWORD@HOST:5432/NAME
# MySQL:    mysql://USER:PASSWORD@HOST:3306/NAME
DATABASE_URL=postgres://bluepark:bluepark@localhost:5432/bluepark

# Redis (production channel layer for real-time kitchen updates --
# dev uses Channels' InMemoryChannelLayer instead, no Redis needed)
REDIS_URL=redis://localhost:6379/0

# AI Operations Copilot (Google Gemini)
# Get a key at https://aistudio.google.com/apikey -- see the README's
# "AI setup" section. Leave blank to run everything else without it;
# the copilot API returns a clear 503 instead of crashing if unset.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
