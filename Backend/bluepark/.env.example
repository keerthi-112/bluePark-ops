# Copy this file to .env and fill in real values.
# Not required for local dev — bluepark.settings.dev works with no .env at all.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# Database (django-environ URL format)
# Postgres: postgres://USER:PASSWORD@HOST:5432/NAME
# MySQL:    mysql://USER:PASSWORD@HOST:3306/NAME
DATABASE_URL=postgres://bluepark:bluepark@localhost:5432/bluepark
